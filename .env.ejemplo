# Copiar a .env es OPCIONAL: docker-compose.yml ya usa estos mismos valores por defecto.
# Cámbialos solo si necesitas otra configuración.
OLLAMA_URL=http://ollama:11434
QDRANT_URL=http://qdrant:6333
MODELO_RAPIDO=qwen3.5:0.8b
MODELO_CAPAZ=lfm3:1.7b-q4_K_M
EMB_PRINCIPAL=embeddinggemma-2:440m
EMB_SECUNDARIO=granite-embedding:278m
# Puertos de diagnóstico en el host (solo 127.0.0.1). Cámbialos si ya están ocupados,
# por ejemplo si tienes Ollama instalado de forma nativa: OLLAMA_PUERTO_HOST=11435
OLLAMA_PUERTO_HOST=11434
QDRANT_PUERTO_HOST=6333
