  web["<b>web</b> [contenedor nginx]<br/>reenvía /api/* a servicio:8000"]:::externo

  subgraph C1["C1 · api/"]
    rutas["<b>rutas/</b> [FastAPI]<br/>fichas.py: /fichas, /fichas/{id}, /lotes, /lotes/{id}<br/>busquedas.py: /busquedas<br/>documentos.py: /documentos, /fotos/{id}/miniatura<br/>sistema.py: /health, /configuracion<br/>observabilidad.py: /retroalimentacion, /metricas, /duplicados"]:::comp
    apoyo["<b>middleware.py · errores.py</b><br/>MiddlewareTraza (X-Traza-Id);<br/>errores 400 · 404 · 413 · 415<br/>422 · 503 · 504 en español"]:::comp
    arranque["<b>arranque.py</b><br/>[raíz de composición]<br/>crea los adaptadores de C7<br/>y los conecta con los flujos"]:::raiz
  end

  subgraph C2["C2 · orquestacion/"]
    fficha["<b>FlujoFicha</b><br/>máquina de estados<br/>y ciclo de agente"]:::comp
    fbusq["<b>FlujoBusqueda</b><br/>por texto (P4, P5)<br/>y por foto"]:::comp
    fing["<b>FlujoIngesta</b><br/>fotos, normas<br/>y eliminación"]:::comp
    flotes["<b>GestorLotes</b><br/>un trabajador en<br/>segundo plano"]:::comp
    fotros["<b>FlujoRetroalimentacion</b><br/><b>FlujoMetricas</b><br/><b>FlujoSalud</b>"]:::comp
    fficha ~~~ flotes
    fbusq ~~~ fotros
  end

  subgraph C3["C3 · guardrails/"]
    gent["<b>entrada/</b><br/>archivo.py · exif.py · texto.py<br/>imagen.py (VerificadorImagen)"]:::comp
    gsal["<b>salida/</b><br/>reglas.py: esquema, IPTC, fuentes<br/>semanticas.py: GuardrailsSemanticos"]:::comp
    gpol["<b>politicas.py · resultado.py</b><br/>política por verificación<br/>y ResultadoGuardrail"]:::comp
  end

  subgraph C6["C6 · modelos/"]
    gw["<b>Gateway</b><br/>ejecutar(tarea, variables,<br/>imágenes): tiempo límite,<br/>reintento y respaldo"]:::comp
    efi["<b>EnrutadorFichas</b><br/>rápida o completa"]:::comp
    ebu["<b>EnrutadorBusquedas</b><br/>simple, compleja o imagen"]:::comp
    pl["<b>plantillas.py</b><br/><b>validacion.py</b><br/>prompts/P1–P6.md"]:::comp
    gw ~~~ ebu
    efi ~~~ pl
  end

  subgraph C5["C5 · contexto/"]
    rej["<b>RecuperadorEjemplos</b><br/>fotos_img + fotos_txt, RRF"]:::comp
    rnor["<b>RecuperadorNormas</b><br/>colección normas"]:::comp
    tes["<b>Tesauro</b><br/>candidatos y<br/>normalización"]:::comp
    ens["<b>ensamblador_prompt.py</b><br/>ids estables y presupuesto"]:::comp
    frag["<b>fragmentador.py</b><br/><b>fusion.py</b> (RRF)"]:::comp
    rej ~~~ ens
    rnor ~~~ frag
  end

